{
  "sourceLanguage": "en",
  "strings": {
    "Ask anything": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问点什么…"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "Hotkey %@ is used by macOS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键 %@ 已被 macOS 占用"
          }
        }
      }
    },
    "If nothing happens when you press the Hotkey, it may conflict with another app such as ChatGPT. Try a different combination.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果按下全局快捷键没有反应，可能和 ChatGPT 等 app 冲突，请换一个组合。"
          }
        }
      }
    },
    "New Conversation (⌘N)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新对话（⌘N）"
          }
        }
      }
    },
    "Pressing it won't open the Quick Panel. Turn off that shortcut in System Settings › Keyboard › Keyboard Shortcuts, or choose another Hotkey in Chatbot's settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下它打不开面板。请在「系统设置 › 键盘 › 键盘快捷键」里关掉那个系统快捷键，或者在 Chatbot 的设置里换一个全局快捷键。"
          }
        }
      }
    },
    "Quit Chatbot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Chatbot"
          }
        }
      }
    },
    "Send (⏎)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送（⏎）"
          }
        }
      }
    },
    "Stop (⌘.)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止（⌘.）"
          }
        }
      }
    },
    "What can I help with?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么可以帮你？"
          }
        }
      }
    },
    "⏎ Send · ⇧⏎ New Line": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⏎ 发送 · ⇧⏎ 换行"
          }
        }
      }
    }
  },
  "version": "1.0"
}
