    "Add a Connection with the + button, then paste your API key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「+」添加一个 Connection，然后粘贴 API key。"
          }
        }
      }
    },
    "Add a model ID manually": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动填写模型 ID"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "All conversations and their attachments will be deleted. This can't be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有对话及其附件都会被删除，无法恢复。"
          }
        }
      }
    },
    "All conversations that use this Connection will be deleted too. This can't be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这个 Connection 的所有对话也会一起删除，无法恢复。"
          }
        }
      }
    },
    "Allow Chatbot in System Settings › General › Login Items.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「系统设置 › 通用 › 登录项」里允许 Chatbot。"
          }
        }
      }
    },
    "Ask anything": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问点什么…"
