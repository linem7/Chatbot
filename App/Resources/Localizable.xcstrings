{
  "sourceLanguage": "en",
  "strings": {
    "%lld models available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的 Model：%lld 个"
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key"
          }
        }
      }
    },
    "Add Connection…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Connection…"
          }
        }
      }
    },
    "Add Files…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加附件…"
          }
        }
      }
    },
    "Ask anything": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问点什么…"
          }
        }
      }
    },
    "Chatbot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatbot"
          }
        }
      }
    },
    "Continue in Quick Panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Quick Panel 中继续"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "Couldn't read the API key from the Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串读取 API key。"
          }
        }
      }
    },
    "Couldn't read “%@”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取「%@」。"
          }
        }
      }
    },
    "Couldn't save the API key to the Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法把 API key 存进钥匙串。"
          }
        }
      }
    },
    "DeepSeek": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek"
          }
        }
      }
    },
    "Default Model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 Model"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Hotkey %@ is used by macOS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键 %@ 已被 macOS 占用"
          }
        }
      }
    },
    "If nothing happens when you press the Hotkey, it may conflict with another app such as ChatGPT. Try a different combination.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果按下全局快捷键没有反应，可能和 ChatGPT 等 app 冲突，请换一个组合。"
          }
        }
      }
    },
    "Interrupted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已中断"
          }
        }
      }
    },
    "Network connection failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接失败。"
          }
        }
      }
    },
    "New Conversation (⌘N)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新对话（⌘N）"
          }
        }
      }
    },
    "No Conversation Selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有选中对话"
          }
        }
      }
    },
    "No Conversations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有对话"
          }
        }
      }
    },
    "Open Main Window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开主窗口"
          }
        }
      }
    },
    "Open in Main Window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主窗口中打开"
          }
        }
      }
    },
    "Pasted Image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴的图片"
          }
        }
      }
    },
    "Pressing it won't open the Quick Panel. Turn off that shortcut in System Settings › Keyboard › Keyboard Shortcuts, or choose another Hotkey in Chatbot's settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下它打不开面板。请在「系统设置 › 键盘 › 键盘快捷键」里关掉那个系统快捷键，或者在 Chatbot 的设置里换一个全局快捷键。"
          }
        }
      }
    },
    "Quit Chatbot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Chatbot"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Saved — paste a new key to replace it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存，粘贴新的 key 可以替换"
          }
        }
      }
    },
    "Send (⏎)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送（⏎）"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "Stop (⌘.)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止（⌘.）"
          }
        }
      }
    },
    "The API key is invalid or has expired.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API key 无效或已过期。"
          }
        }
      }
    },
    "The current model can't accept images.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型不能接受图片。"
          }
        }
      }
    },
    "The current model doesn't support this input.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型不支持这种输入。"
          }
        }
      }
    },
    "The service is temporarily unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务暂时不可用。"
          }
        }
      }
    },
    "This conversation is too long. Start a new one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话太长了，请新开一个对话。"
          }
        }
      }
    },
    "Too many requests or out of quota.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁或额度已用完。"
          }
        }
      }
    },
    "Too many requests or out of quota. Try again in %lld seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁或额度已用完，请 %lld 秒后再试。"
          }
        }
      }
    },
    "Untitled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名"
          }
        }
      }
    },
    "What can I help with?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么可以帮你？"
          }
        }
      }
    },
    "sk-…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sk-…"
          }
        }
      }
    },
    "“%@” has no text to extract. It may be a scanned PDF.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」里没有可以抽取的文字，可能是扫描版 PDF。"
          }
        }
      }
    },
    "“%@” isn't a supported file type.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持「%@」这种文件类型。"
          }
        }
      }
    },
    "⏎ Send · ⇧⏎ New Line": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⏎ 发送 · ⇧⏎ 换行"
          }
        }
      }
    }
  },
  "version": "1.0"
}
